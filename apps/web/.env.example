# API origin — hooks append /api/v1 (required for most pages)
NEXT_PUBLIC_API_URL=https://cms.armada.nu # or http://localhost:8080 when running ArmadaCMS locally

# Chromatic (optional for local Storybook publishing)
CHROMATIC_PROJECT_TOKEN=

# reCAPTCHA Enterprise (exhibitor sales forms).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_PROJECT_ID=

# Slack webhook (only needed for exhibitor sales form submissions)
SLACK_SALES_HOOK_URL=

# On-demand cache revalidation webhook from ArmadaCMS
REVALIDATION_SECRET=
# Public Eventro campaign used by the recruitment email signup form
NEXT_PUBLIC_EVENTRO_RECRUITMENT_EMAIL_CAMPAIGN_ID=

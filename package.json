{
  "name": "armada.nu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @armada/web dev",
    "build": "pnpm -r --filter @armada/web --filter @armada/photos --filter @armada/order build",
    "start": "pnpm --filter @armada/web start",
    "prepare": "husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "type-check": "pnpm -r type-check && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "test": "vitest run",
    "chromatic": "chromatic",
    "dev:photos": "pnpm --filter @armada/photos dev",
    "dev:order": "pnpm --filter @armada/order dev",
    "dev:all": "pnpm --parallel --filter @armada/web --filter @armada/photos --filter @armada/order dev"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,json,md,mjs}": "prettier --write",
    "**/*.{ts,tsx,js,jsx}": "eslint --fix"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vercel/analytics": "^2.0.1",
    "chromatic": "^18.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next": "16.3.8",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.18.0"
}
